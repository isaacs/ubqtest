{
  "file": "test/duration.test.ts",
  "imports": { "../src/duration.ts": ["UNIT_MS", "parseDuration"] },
  "tests": [
    { "name": "a minute", "checks": [["equal", "UNIT_MS.m", "60_000"]] },
    {
      "name": "parseDuration: each unit",
      "checks": [
        ["equal", "parseDuration('250ms')", "250"],
        ["equal", "parseDuration('90s')", "90_000"],
        ["equal", "parseDuration('2m')", "120_000"],
        ["equal", "parseDuration('3h')", "10_800_000"],
        ["equal", "parseDuration('2d')", "172_800_000"]
      ]
    },
    { "name": "parseDuration: parts", "checks": [["equal", "parseDuration('1h30m')", "5_400_000"]] },
    {
      "name": "parseDuration: not a duration",
      "checks": [
        ["throws", "() => parseDuration('')", "SyntaxError"],
        ["throws", "() => parseDuration('10')", "SyntaxError"],
        ["throws", "() => parseDuration('5x')", "SyntaxError"]
      ]
    }
  ]
}
