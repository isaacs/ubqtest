{
  "name": "ubqtest",
  "version": "0.0.3",
  "description": "The test framework designed specifically for coding agents who write TypeScript, and their humans.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isaacs/ubqtest.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser.ts",
    "./preload": "./src/preload.ts",
    "./bun-preload": "./src/bun-preload.ts",
    "./counters-preload": "./src/counters-preload.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepare": "node test/setup.ts",
    "test": "node src/cli.ts",
    "typecheck": "tsc",
    "bench": "npm run build && node experiments/suite/bench.mjs",
    "build": "node scripts/build.ts",
    "docs": "npm run build && node scripts/api-docs.ts",
    "site": "node scripts/site.ts",
    "preversion": "npm test",
    "postversion": "git push origin --follow-tags",
    "site:go": "npx -y wrangler@4 deploy",
    "site:dev": "npx -y wrangler@4 dev"
  },
  "devDependencies": {
    "@sveltejs/acorn-typescript": "^1.0.13",
    "@types/node": "^26.6.6",
    "acorn": "^8.19.0",
    "esbuild": "^0.28.2",
    "marked": "^18.2.0",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2"
  },
  "bin": {
    "ubq": "src/cli.ts"
  },
  "license": "BlueOak-1.0.0",
  "ubq": {
    "timeout": 120000
  }
}
