{
  "name": "ubqtest",
  "version": "0.0.0",
  "private": true,
  "description": "The test framework designed specifically for coding agents who write TypeScript, and their humans.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./preload": "./src/preload.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node src/cli.ts test",
    "typecheck": "tsc",
    "bench": "npm run build && node experiments/suite/bench.mjs",
    "build": "esbuild src/index.ts src/cli.ts src/preload.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "bin": {
    "ubq": "./src/cli.ts"
  }
}
